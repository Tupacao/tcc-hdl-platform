# Variaveis da stack de producao (infra/docker-compose.prod.yml).
# Copie para infra/.env NA VM e preencha. Este arquivo nunca contem segredo real:
# o .env de producao fica fora do repositorio (.gitignore).

# --- Dominio e TLS -----------------------------------------------------------
# Dominio que aponta para o IP publico da VM. O Caddy emite o certificado para ele.
TPLAB_DOMAIN=tplab.exemplo.br
# E-mail de contato do Let's Encrypt (avisos de expiracao).
TPLAB_ACME_EMAIL=voce@exemplo.br

# --- Frontend ----------------------------------------------------------------
# Origem do frontend publicado, para o CORS da API (RNF02). Varias: separe por virgula.
# Servindo o dist pela propria VM, e o mesmo dominio de cima (https://...).
CORS_ORIGIN=https://tplab.exemplo.br
# Caminho do `dist` do frontend na VM, quando servido pelo Caddy.
# Deixe comentado para publicar o frontend no Azure Static Web Apps.
# FRONTEND_DIST=/opt/tplab/web-dist

# --- Banco -------------------------------------------------------------------
POSTGRES_USER=tplab
# Gerar com: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=tplab

# --- Feedback (RF17) ---------------------------------------------------------
# Sal do hash de IP/sessao. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FEEDBACK_IP_SALT=
FEEDBACK_MAX_PER_DAY=5

# --- Sandbox (RNF04/RNF05) ---------------------------------------------------
# Diretorio dos fontes de cada job. Precisa existir na VM e ser o MESMO caminho
# dentro do worker (o bind do container de simulacao e resolvido no host).
SANDBOX_WORKDIR_ROOT=/var/lib/tplab/work
SANDBOX_IMAGE=tplab-sandbox:latest
SANDBOX_IMAGE_GHDL=tplab-sandbox-ghdl:latest
SANDBOX_TIMEOUT_MS=10000
SANDBOX_COMPILE_TIMEOUT_MS=5000
SANDBOX_MEMORY_MB=128
SANDBOX_CPUS=0.5

# --- Fila (RF03) -------------------------------------------------------------
SIMULATION_MAX_QUEUE_DEPTH=50
JOB_RETENTION_SECONDS=1800
JOB_RETENTION_COUNT=100
