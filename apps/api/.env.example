NODE_ENV=development
HOST=0.0.0.0
PORT=3333

# Origem permitida do frontend (RNF02)
CORS_ORIGIN=http://localhost:5173

# Fila de jobs de compilacao/simulacao
REDIS_URL=redis://localhost:6379
# Acima disso, novas submissoes sao recusadas com 503 (RF03-I02)
SIMULATION_MAX_QUEUE_DEPTH=50
# Retencao dos resultados no Redis (RF03-I03) — sempre acima do POLL_TIMEOUT_MS
# do cliente (60s), ou o polling perde o resultado no meio do caminho.
JOB_RETENTION_SECONDS=1800
JOB_RETENTION_COUNT=100

# Banco relacional (Postgres) — persistencia de projetos via Prisma (RF07).
# Sem ela a API sobe em memoria (dev); obrigatoria quando NODE_ENV=production.
DATABASE_URL=postgresql://tplab:tplab@localhost:5432/tplab

# Sandbox de execucao (RNF04/RNF05)
SANDBOX_IMAGE=tplab-sandbox:latest
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MEMORY_MB=128
SANDBOX_CPUS=0.5
# Tetos dos artefatos retidos por job (RF04-I02)
MAX_STDOUT_BYTES=262144
MAX_STDERR_BYTES=65536
MAX_VCD_BYTES=2097152
