NODE_ENV=development
HOST=0.0.0.0
PORT=3333

# Origem permitida do frontend (RNF02)
CORS_ORIGIN=http://localhost:5173

# Fila de jobs de compilacao/simulacao
REDIS_URL=redis://localhost:6379

# Banco relacional (Postgres) — usado quando o Prisma for plugado
DATABASE_URL=postgresql://hdl:hdl@localhost:5432/hdl

# Sandbox de execucao (RNF04/RNF05)
SANDBOX_IMAGE=hdl-sandbox:latest
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MEMORY_MB=128
SANDBOX_CPUS=0.5
