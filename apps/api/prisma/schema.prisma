// Schema do Prisma (RF07-I01). O contrato publico da API continua em
// packages/shared/src/schemas/project.ts (ProjectSchema); este schema so
// descreve a persistencia.

generator client {
  provider      = "prisma-client-js"
  // "native" cobre o dev local (Windows/macOS/Linux glibc); a variante musl
  // cobre o runtime de producao (node:22-alpine no Dockerfile).
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  /// Par design/testbench (HdlSourcesSchema) — validado por Zod na borda, guardado cru.
  sources     Json
  /// Preparado para RF14/RNF06 (dono do projeto); nulo ate a autenticacao existir.
  ownerId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([updatedAt])
}

/// Feedback enviado pelos usuarios (RF17). Texto livre: tratado como dado, nunca
/// interpolado em log nem renderizado como HTML.
model Feedback {
  id      String @id @default(uuid())
  /// FeedbackKindSchema: problema | sugestao | elogio | outro.
  kind    String
  message String
  /// E-mail opcional de quem enviou; nulo quando a pessoa nao quis se identificar.
  contact String?
  /// FeedbackContextSchema — navegador, tela, projeto, ultima execucao. Nulo quando
  /// o usuario desligou o envio de contexto tecnico.
  context Json?
  /// Preparado para RF14 (feedback de usuario autenticado); nulo no acesso anonimo.
  userId  String?
  /// SHA-256 do IP com sal (FEEDBACK_IP_SALT) — agrupa abuso sem guardar dado
  /// pessoal. O IP em claro nunca e gravado.
  ipHash    String?
  /// Chave do limite diario, tambem com sal: a sessao anonima quando o relato traz
  /// uma, senao o IP. Separada de ipHash porque o limite e por sessao (decisao de
  /// design: um laboratorio atras do mesmo endereco nao compartilha a cota).
  limitKey  String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind])
  @@index([limitKey, createdAt])
}
