{
  "name": "tplab",
  "version": "0.1.0",
  "private": true,
  "description": "TPLab - plataforma web educacional para desenvolvimento e simulacao de circuitos digitais em HDL",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "pnpm --filter @tplab/shared build && pnpm --parallel --filter @tplab/shared --filter \"./apps/*\" dev",
    "dev:web": "pnpm --filter @tplab/web dev",
    "dev:api": "pnpm --filter @tplab/api dev",
    "dev:worker": "pnpm --filter @tplab/api dev:worker",
    "build": "pnpm --filter @tplab/shared build && pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "sandbox:build": "docker build -t tplab-sandbox:latest infra/sandbox"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
